<Window x:Class="ClipboardHistory.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardHistory"
        Title="历史粘贴板"
        Width="860"
        Height="760"
        MinWidth="650"
        MinHeight="480"
        Background="#F4F8FC"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="历史粘贴板" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="复制过的文字和图片，都在这里" Margin="0,4,0,0"
                           Foreground="{StaticResource MutedBrush}" FontSize="13" />
            </StackPanel>
            <Button Grid.Column="1" Content="打开保存位置" Click="OpenDataFolder_Click"
                    VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Height="42">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                         ToolTip="搜索文字内容和图片中识别出的文字"
                         TextChanged="SearchBox_TextChanged" />
                <TextBlock Text="搜索文字内容或图片中的文字" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="#9AA9B6"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,12,0,0" VerticalAlignment="Center">
                <TextBlock Text="保留时长" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="RetentionCombo" Width="140" Height="34"
                          SelectionChanged="RetentionCombo_SelectionChanged">
                    <ComboBoxItem Content="1 天" Tag="1" />
                    <ComboBoxItem Content="3 天" Tag="3" />
                    <ComboBoxItem Content="5 天" Tag="5" />
                    <ComboBoxItem Content="自定义" Tag="custom" />
                </ComboBox>
                <TextBox x:Name="CustomDaysBox" Width="64" Height="34" Margin="8,0,0,0"
                         VerticalContentAlignment="Center" TextChanged="CustomDaysBox_TextChanged" />
                <TextBlock Text="天（1–30）" VerticalAlignment="Center" Margin="6,0,20,0"
                           Foreground="{StaticResource MutedBrush}" />
                <CheckBox x:Name="StartupCheck" Content="开机自动启动" VerticalAlignment="Center"
                          Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" />
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HistoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="#E6EDF4" BorderThickness="1"
                                        CornerRadius="10" Padding="15" Margin="0,0,0,10"
                                        MouseLeftButtonUp="EntryCard_MouseLeftButtonUp"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="{Binding IsPinned, Converter={x:Static local:BooleanToPinTextConverter.Instance}}"
                                                        Click="PinButton_Click" Padding="9,5" Margin="0,0,6,0" />
                                                <Button Content="删除" Click="DeleteButton_Click"
                                                        Padding="9,5" Background="#FFF0F0" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,12,0,0"
                                                   TextWrapping="Wrap" MaxHeight="76"
                                                   TextTrimming="CharacterEllipsis" FontSize="14" />
                                        <Image Grid.Row="2" Source="{Binding Preview}" MaxHeight="220"
                                               MaxWidth="420" Stretch="Uniform" HorizontalAlignment="Left"
                                               Margin="0,10,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="EmptyMessage" Text="还没有历史记录。复制一段文字或一张图片试试看。"
                           Foreground="{StaticResource MutedBrush}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Text="点击卡片即可粘贴到上一个窗口"
                   Margin="2,12,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
